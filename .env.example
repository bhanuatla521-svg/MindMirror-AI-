# ==========================================
# MindMirror AI - Server & AI Configuration Template
# ==========================================

PORT=3001
NODE_ENV=development

# Providers: 'gemini' | 'groq' | 'cerebras' | 'ollama' | 'local_heuristic'
PRIMARY_AI_PROVIDER=gemini
FALLBACK_AI_PROVIDERS=groq,cerebras,ollama,local_heuristic

# 1. Google Gemini API (Primary Hosted Provider)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# 2. Groq (Optional High-speed Alternative)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# 3. Cerebras (Optional Ultra-fast Alternative)
CEREBRAS_API_KEY=your_cerebras_api_key_here
CEREBRAS_MODEL=llama3.1-8b

# 4. Ollama (Optional Private Local Model)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Request Budgets & Cost Safeguards
DAILY_REQUEST_BUDGET=100
MONTHLY_REQUEST_BUDGET=2500
MAX_TOKENS_PER_ANALYSIS=2048
AI_REQUEST_TIMEOUT_MS=15000

# Supabase PostgreSQL & Auth
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
